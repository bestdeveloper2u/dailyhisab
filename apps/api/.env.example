# Daily Khoroch API — local environment template. Copy to .env and adjust.
KHOROCH_DATABASE_URL=postgresql+asyncpg://khoroch:khoroch@localhost:54329/khoroch
KHOROCH_ENV=local
KHOROCH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:80"]
# --- Phase 1 auth ---------------------------------------------------------
# REQUIRED in prod (server refuses to boot without it); leave empty locally
# and an ephemeral random secret is generated with a warning.
KHOROCH_JWT_SECRET=
# Redis for sessions/rate limits. Empty = in-process MemoryKV (local only).
# KHOROCH_KV_URL=redis://localhost:6379/0
# Access token lifetime in seconds (default 900 = 15 min).
KHOROCH_ACCESS_TTL=900
# Refresh token / session lifetime in seconds (default 2592000 = 30 days).
KHOROCH_REFRESH_TTL=2592000
# Max requests per minute per (ip, email) on register/login/refresh.
KHOROCH_AUTH_RATE_LIMIT=5
