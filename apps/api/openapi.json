{
  "components": {
    "schemas": {
      "AuthOut": {
        "description": "Login/register/refresh response: user + token pair.",
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "refreshToken": {
            "title": "Refreshtoken",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "accessToken",
          "refreshToken"
        ],
        "title": "AuthOut",
        "type": "object"
      },
      "BulkExpensesIn": {
        "description": "POST /expenses/bulk body (voice multi-item inserts).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExpenseIn"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "BulkExpensesIn",
        "type": "object"
      },
      "BulkExpensesOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExpenseOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "BulkExpensesOut",
        "type": "object"
      },
      "ExpenseIn": {
        "description": "POST /expenses and POST /expenses/bulk item body.",
        "properties": {
          "amt": {
            "examples": [
              "890.00"
            ],
            "pattern": "^\\d{1,10}\\.\\d{2}$",
            "title": "Amt",
            "type": "string"
          },
          "cat": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Cat",
            "type": "string"
          },
          "desc": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Desc"
          },
          "grp": {
            "enum": [
              "food",
              "housing",
              "utility",
              "transport",
              "health",
              "education",
              "personal",
              "other"
            ],
            "title": "Grp",
            "type": "string"
          },
          "iso": {
            "format": "date",
            "title": "Iso",
            "type": "string"
          },
          "pay": {
            "default": "cash",
            "enum": [
              "cash",
              "bkash",
              "nagad",
              "rocket",
              "card",
              "bank"
            ],
            "title": "Pay",
            "type": "string"
          }
        },
        "required": [
          "cat",
          "grp",
          "amt",
          "iso"
        ],
        "title": "ExpenseIn",
        "type": "object"
      },
      "ExpenseListOut": {
        "description": "Envelope for every list endpoint (ADR-0004 \u00a78).",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExpenseOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ExpenseListOut",
        "type": "object"
      },
      "ExpenseOut": {
        "description": "Public expense row; keys mirror the DB columns exactly.",
        "properties": {
          "amt": {
            "title": "Amt",
            "type": "string"
          },
          "cat": {
            "title": "Cat",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "desc": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Desc"
          },
          "grp": {
            "enum": [
              "food",
              "housing",
              "utility",
              "transport",
              "health",
              "education",
              "personal",
              "other"
            ],
            "title": "Grp",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "iso": {
            "format": "date",
            "title": "Iso",
            "type": "string"
          },
          "pay": {
            "enum": [
              "cash",
              "bkash",
              "nagad",
              "rocket",
              "card",
              "bank"
            ],
            "title": "Pay",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "cat",
          "grp",
          "amt",
          "pay",
          "iso",
          "created_at"
        ],
        "title": "ExpenseOut",
        "type": "object"
      },
      "ExpenseUpdate": {
        "description": "PATCH /expenses/{id} body \u2014 every field optional (partial update).",
        "properties": {
          "amt": {
            "anyOf": [
              {
                "examples": [
                  "890.00"
                ],
                "pattern": "^\\d{1,10}\\.\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amt"
          },
          "cat": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cat"
          },
          "desc": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Desc"
          },
          "grp": {
            "anyOf": [
              {
                "enum": [
                  "food",
                  "housing",
                  "utility",
                  "transport",
                  "health",
                  "education",
                  "personal",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grp"
          },
          "iso": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Iso"
          },
          "pay": {
            "anyOf": [
              {
                "enum": [
                  "cash",
                  "bkash",
                  "nagad",
                  "rocket",
                  "card",
                  "bank"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pay"
          }
        },
        "title": "ExpenseUpdate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Healthz": {
        "properties": {
          "env": {
            "title": "Env",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "env"
        ],
        "title": "Healthz",
        "type": "object"
      },
      "LoginIn": {
        "description": "POST /auth/login body.",
        "properties": {
          "email": {
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "MonthlyReportOut": {
        "properties": {
          "by_day": {
            "items": {
              "$ref": "#/components/schemas/ReportByDay"
            },
            "title": "By Day",
            "type": "array"
          },
          "by_group": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "By Group",
            "type": "object"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "string"
          },
          "ym": {
            "title": "Ym",
            "type": "string"
          }
        },
        "required": [
          "ym",
          "total",
          "count",
          "by_group",
          "by_day"
        ],
        "title": "MonthlyReportOut",
        "type": "object"
      },
      "ParsedItem": {
        "description": "One expense candidate extracted from a transcript segment.",
        "properties": {
          "amt": {
            "title": "Amt",
            "type": "string"
          },
          "cat": {
            "title": "Cat",
            "type": "string"
          },
          "desc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Desc"
          },
          "grp": {
            "enum": [
              "food",
              "housing",
              "utility",
              "transport",
              "health",
              "education",
              "personal",
              "other"
            ],
            "title": "Grp",
            "type": "string"
          },
          "iso": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Iso"
          },
          "pay": {
            "anyOf": [
              {
                "enum": [
                  "cash",
                  "bkash",
                  "nagad",
                  "rocket",
                  "card",
                  "bank"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pay"
          }
        },
        "required": [
          "cat",
          "grp",
          "amt"
        ],
        "title": "ParsedItem",
        "type": "object"
      },
      "RefreshIn": {
        "description": "POST /auth/refresh body.",
        "properties": {
          "refreshToken": {
            "maxLength": 512,
            "minLength": 16,
            "title": "Refreshtoken",
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "title": "RefreshIn",
        "type": "object"
      },
      "RegisterIn": {
        "description": "POST /auth/register body.",
        "properties": {
          "email": {
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterIn",
        "type": "object"
      },
      "ReportByDay": {
        "properties": {
          "iso": {
            "format": "date",
            "title": "Iso",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "string"
          }
        },
        "required": [
          "iso",
          "total"
        ],
        "title": "ReportByDay",
        "type": "object"
      },
      "ReportByMonth": {
        "properties": {
          "total": {
            "title": "Total",
            "type": "string"
          },
          "ym": {
            "title": "Ym",
            "type": "string"
          }
        },
        "required": [
          "ym",
          "total"
        ],
        "title": "ReportByMonth",
        "type": "object"
      },
      "UserOut": {
        "description": "Public view of a profile.",
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoiceParseIn": {
        "description": "POST /voice/parse body.",
        "properties": {
          "text": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "VoiceParseIn",
        "type": "object"
      },
      "VoiceParseOut": {
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ParsedItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "confidence"
        ],
        "title": "VoiceParseOut",
        "type": "object"
      },
      "YearlyReportOut": {
        "properties": {
          "by_group": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "By Group",
            "type": "object"
          },
          "by_month": {
            "items": {
              "$ref": "#/components/schemas/ReportByMonth"
            },
            "title": "By Month",
            "type": "array"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "string"
          },
          "year": {
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "year",
          "total",
          "count",
          "by_group",
          "by_month"
        ],
        "title": "YearlyReportOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Daily Hisab API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Verify credentials and start a session (401 with a uniform message).",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Revoke the caller's session and its current refresh token (204).",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "Return the authenticated user's public profile.",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Rotate a refresh token; reuse of an old token revokes the session.",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Create a profile and start a session (201 with a fresh token pair).",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/expenses": {
      "get": {
        "description": "List the caller's expenses, newest first, keyset-paginated.",
        "operationId": "list_expenses_api_v1_expenses_get",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseListOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Expenses",
        "tags": [
          "expenses"
        ]
      },
      "post": {
        "description": "Record one expense (201 with the stored row).",
        "operationId": "create_expense_api_v1_expenses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Expense",
        "tags": [
          "expenses"
        ]
      }
    },
    "/api/v1/expenses/bulk": {
      "post": {
        "description": "Insert up to 50 expenses for the caller in a single flush.",
        "operationId": "create_expenses_bulk_api_v1_expenses_bulk_post",
        "requestBody": {
          "content": {
