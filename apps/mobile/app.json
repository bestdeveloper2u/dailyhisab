{
  "expo": {
    "name": "Daily Khoroch",
    "slug": "dailykhoroch",
    "version": "0.3.0",
    "scheme": "khoroch",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F6F5F1",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
